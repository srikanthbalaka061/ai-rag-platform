PORT=3000
QDRANT_URL=https://your-qdrant-instance
QDRANT_API_KEY=replace-with-your-api-key
QDRANT_COLLECTION=enterprise_documents
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
GENERATION_MODEL=Xenova/flan-t5-small
BHARATSTOCK_BASE_URL=https://bharatstockapi.com
BHARATSTOCK_API_KEY=replace-with-your-bharatstock-api-key
BHARATSTOCK_TIMEOUT_MS=10000
MARKET_DATA_SYNC_TIMEZONE=Asia/Kolkata
MARKET_DATA_SYNC_MAX_PAGES=100
AUTH_SUPABASE_URL=https://your-atlas-auth-project.supabase.co
AUTH_SUPABASE_PUBLISHABLE_KEY=replace-with-your-atlas-project-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-service-role-key
